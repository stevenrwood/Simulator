# Windows thumbnail cache files
Thumbs.db
ehthumbs.db
ehthumbs_vista.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Subversion folders

.svn

# Build folders - out-of-source CMake trees. Nothing under build* is tracked,
# so the glob is safe and covers build-local/, build-matched/, build-root/,
# build_verify/ and whatever the next one gets called.

build
build*/

#
# =========================
# Operating System Files
# =========================

.vscode

# make output
*.o
*.exe

# run output
*.out
*.DAT
littlefs.img

# Claude Code turn loop (hub-managed hooks); settings.json and turn-config.json ARE tracked
.claude/turn-state.json
**/.claude/turn-state.json
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock
